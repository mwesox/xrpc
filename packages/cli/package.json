{
  "name": "@xrpckit/cli",
  "version": "0.0.3",
  "description": "CLI for xRPC - generate type-safe API code from Zod schemas",
  "type": "module",
  "license": "MIT",
  "author": "mwesox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwesox/xrpc.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/mwesox/xrpc/issues"
  },
  "homepage": "https://github.com/mwesox/xrpc#readme",
  "keywords": [
    "xrpc",
    "rpc",
    "cli",
    "typescript",
    "codegen",
    "api",
    "type-safe",
    "zod"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "xrpc": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.2.0",
    "@xrpckit/sdk": "^0.0.3",
    "@xrpckit/target-go-server": "^0.0.3",
    "@xrpckit/target-kotlin-spring-boot-server": "^0.0.2",
    "@xrpckit/target-swift-client": "^0.0.2",
    "@xrpckit/target-ts-server": "^0.0.2",
    "@xrpckit/target-ts-client": "^0.0.3",
    "chalk": "^5.3.0",
    "figlet": "^1.7.0",
    "ora": "^9.1.0",
    "smol-toml": "^1.3.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
