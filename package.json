{
  "name": "x-rpc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/target-*",
    "examples/*",
    "examples/x-rpc-todo-app",
    "examples/x-rpc-todo-app/apps/*",
    "examples/x-rpc-todo-app/packages/*",
    "tests/fixtures"
  ],
  "scripts": {
    "build": "bun run --filter='./packages/*' build",
    "dev": "bun run --filter='./packages/cli' dev",
    "docs:dev": "bun run --filter='./apps/docs' dev",
    "docs:build": "bun run --filter='./apps/docs' build",
    "docs:preview": "bun run --filter='./apps/docs' preview",
    "generate": "bun run packages/cli/src/index.ts generate",
    "xrpc": "bun run packages/cli/src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check packages",
    "lint:fix": "biome check --write packages",
    "format": "biome format --write packages",
    "test": "bun test",
    "test:parser": "bun test packages/parser/src",
    "test:e2e": "bun test tests/e2e",
    "check": "bun run build && bun run typecheck && bun run lint && bun run test",
    "release:status": "bunx changeset status",
    "release:version": "bunx changeset version",
    "release:preflight": "node scripts/release/preflight.mjs",
    "release:publish:dry": "node scripts/release/publish.mjs --dry-run",
    "release:publish": "node scripts/release/publish.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@biomejs/biome": "^2.3.14",
    "@types/bun": "^1.3.8",
    "@types/node": "^25.2.2",
    "knip": "^6.7.0",
    "typescript": "^5.9.3"
  }
}
