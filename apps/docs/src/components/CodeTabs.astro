---
import { Code } from "astro:components";

interface Tab {
  id: string;
  label: string;
  code: string;
  lang?: string;
}

interface Props {
  tabs: Tab[];
}

const { tabs } = Astro.props;
---

<div class="code-tabs">
  <div class="code-tabs-nav">
    {tabs.map((tab, i) => (
      <button class:list={["code-tab-btn", { active: i === 0 }]} data-tab={tab.id}>
        {tab.label}
      </button>
    ))}
  </div>
  {tabs.map((tab, i) => (
    <div class:list={["code-tab-panel", { active: i === 0 }]} data-tab={tab.id}>
      <Code code={tab.code} lang={tab.lang || "typescript"} />
    </div>
  ))}
</div>
